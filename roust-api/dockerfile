# syntax=docker/dockerfile:1
# NOTE: roust-api depends on WinDivert / windows crate. Linux Docker builds fail.
# Prefer host binary on Windows; this file exists for deploy-script contract alignment.
# Build from repo root: docker build -f dockerfile -t roust-api:latest .

FROM rust:1.88-bookworm AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY build.rs ./
COPY src ./src
RUN cargo build --release --bin roust-api

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /src/target/release/roust-api /app/roust-api
EXPOSE 8787
CMD ["/app/roust-api", "--bind", "0.0.0.0:8787"]